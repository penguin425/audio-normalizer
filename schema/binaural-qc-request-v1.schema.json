{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/audio-normalizer/schema/binaural-qc-request-v1.schema.json",
  "title": "Forge binaural QC request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "rendered", "input_layout", "renderer"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"type": "string", "minLength": 1},
    "rendered": {"type": "string", "minLength": 1},
    "reference": {"type": ["string", "null"], "minLength": 1},
    "input_layout": {
      "type": "string",
      "enum": ["5.1", "6.1", "7.1", "5.1.4", "7.1.4"]
    },
    "renderer": {"$ref": "#/$defs/renderer"},
    "max_duration_delta_seconds": {"type": "number", "minimum": 0},
    "max_loudness_delta_lu": {"type": "number", "minimum": 0},
    "max_true_peak_delta_db": {"type": "number", "minimum": 0},
    "true_peak_ceiling_dbtp": {"type": "number", "minimum": -120, "maximum": 6},
    "max_clipped_samples": {"type": "integer", "minimum": 0},
    "max_input_bytes": {"type": "integer", "minimum": 1},
    "max_decoded_samples": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "renderer_sha256", "model", "model_version", "model_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "renderer_sha256": {"$ref": "#/$defs/sha256"},
        "model": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "model_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    }
  }
}
