{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguin425.github.io/audio-normalizer/schema/nmos-qc-v1",
  "title": "Forge NMOS snapshot QC report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generator", "path", "passed", "warning_count", "findings", "properties"],
  "properties": {
    "schema": {"const": "https://penguin425.github.io/audio-normalizer/schema/nmos-qc-v1"},
    "generator": {"const": "forge-nmos-qc"},
    "path": {"type": "string"},
    "passed": {"type": "boolean"},
    "warning_count": {"type": "integer", "minimum": 0},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "severity", "passed", "message"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^FORGE-[A-Z0-9-]+$"},
          "severity": {"enum": ["error", "warning"]},
          "passed": {"type": "boolean"},
          "message": {"type": "string"},
          "observed": true
        }
      }
    },
    "properties": {"type": "object"}
  }
}
