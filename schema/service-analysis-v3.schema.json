{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguin425.github.io/audio-normalizer/schema/service-analysis-v3",
  "title": "Forge bounded service analysis response v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generator",
    "filename",
    "content_type",
    "bytes_received",
    "max_decoded_samples",
    "channel_layout",
    "report"
  ],
  "properties": {
    "schema": {
      "const": "https://penguin425.github.io/audio-normalizer/schema/service-analysis-v3"
    },
    "generator": { "type": "string", "minLength": 1 },
    "filename": { "type": "string", "minLength": 1, "maxLength": 256 },
    "content_type": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "bytes_received": { "type": "integer", "minimum": 1 },
    "max_decoded_samples": { "type": "integer", "minimum": 1 },
    "compliance_profile": { "type": "string", "minLength": 1 },
    "channel_layout": { "$ref": "#/$defs/channelLayout" },
    "report": {
      "type": "object",
      "required": [
        "analysis_engine_id",
        "measurement_algorithm_revision",
        "path",
        "duration_seconds",
        "sample_rate_hz",
        "channels",
        "integrated_lufs",
        "true_peak_dbtp"
      ],
      "properties": {
        "analysis_engine_id": { "const": "forge-fast-bs1770-r4" },
        "measurement_algorithm_revision": { "const": "forge-bs1770-5-r4" },
        "path": { "type": "string", "minLength": 1 },
        "duration_seconds": { "type": "number" },
        "sample_rate_hz": { "type": "integer", "minimum": 1 },
        "channels": { "type": "integer", "minimum": 1 },
        "integrated_lufs": { "$ref": "#/$defs/dbValue" },
        "true_peak_dbtp": { "$ref": "#/$defs/dbValue" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "dbValue": {
      "oneOf": [
        { "type": "number" },
        { "const": "-inf" },
        { "type": "null" }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "channelRole": {
      "oneOf": [
        { "enum": ["main", "surround", "dual-mono", "lfe"] },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["positioned"],
          "properties": {
            "positioned": {
              "type": "object",
              "additionalProperties": false,
              "required": ["azimuth_degrees", "elevation_degrees"],
              "properties": {
                "azimuth_degrees": { "type": "integer", "minimum": -180, "maximum": 180 },
                "elevation_degrees": { "type": "integer", "minimum": -90, "maximum": 90 }
              }
            }
          }
        }
      ]
    },
    "channelAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "role"],
      "properties": {
        "kind": { "enum": ["speaker", "low-frequency-effects", "legacy-role", "unassigned", "ambisonic", "object"] },
        "role": { "$ref": "#/$defs/channelRole" },
        "cicp_position": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 31 },
            { "type": "integer", "minimum": 36, "maximum": 42 },
            { "const": 126 }
          ]
        },
        "azimuth_degrees": { "type": "integer", "minimum": -180, "maximum": 180 },
        "elevation_degrees": { "type": "integer", "minimum": -90, "maximum": 90 },
        "component_index": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "isoBmff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "stream_structure", "format_ordering", "raw_chnl_sha256", "dmix_sha256"],
      "properties": {
        "version": { "type": "integer", "minimum": 0, "maximum": 1 },
        "stream_structure": { "type": "integer", "minimum": 1, "maximum": 3 },
        "format_ordering": { "type": "integer", "minimum": 0, "maximum": 2 },
        "base_channel_count": { "type": "integer", "minimum": 0, "maximum": 255 },
        "defined_layout": { "type": "integer", "minimum": 0, "maximum": 255 },
        "channel_order_definition": { "type": "integer", "minimum": 0, "maximum": 4 },
        "omitted_channels_map": { "type": "integer", "minimum": 0 },
        "object_count": { "type": "integer", "minimum": 0, "maximum": 255 },
        "raw_chnl_sha256": { "$ref": "#/$defs/sha256" },
        "dmix_sha256": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer", "version", "output_configuration", "executable_sha256", "settings_sha256"],
      "properties": {
        "renderer": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "output_configuration": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "settings_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "channelLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "assignments", "provenance", "origin"],
      "properties": {
        "version": { "const": 1 },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65535,
          "items": { "$ref": "#/$defs/channelAssignment" }
        },
        "provenance": { "enum": ["known-speakers", "unknown", "scene-based"] },
        "origin": { "enum": ["compatibility-default", "wave", "flac", "iso-bmff", "decoder", "explicit-override", "renderer"] },
        "wave_channel_mask": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "flac_channel_mask": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "iso_bmff": { "$ref": "#/$defs/isoBmff" },
        "renderer": { "$ref": "#/$defs/renderer" }
      }
    }
  }
}
