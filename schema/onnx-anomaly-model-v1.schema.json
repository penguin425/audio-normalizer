{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguin425.github.io/audio-normalizer/schema/onnx-anomaly-model-v1",
  "title": "Forge ONNX anomaly model manifest v1",
  "description": "Explicit provenance, tensor, calibration, and resource contract for the optional CPU ONNX adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "adapter", "provider", "provider_version",
    "model", "model_version", "model_file", "model_sha256", "license",
    "calibration", "input", "output", "classes", "frame_hop_seconds",
    "limits", "fallback"
  ],
  "properties": {
    "schema": {"const": "https://penguin425.github.io/audio-normalizer/schema/onnx-anomaly-model-v1"},
    "schema_version": {"const": 1},
    "adapter": {"const": "forge-onnx-provider-1"},
    "provider": {"type": "string", "minLength": 1, "maxLength": 512},
    "provider_version": {"type": "string", "minLength": 1, "maxLength": 512},
    "model": {"type": "string", "minLength": 1, "maxLength": 512},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 512},
    "model_file": {"type": "string", "pattern": "^[^/\\\\.][^/\\\\]*$", "maxLength": 512},
    "model_sha256": {"$ref": "#/$defs/sha256"},
    "license": {"$ref": "#/$defs/license"},
    "calibration": {"$ref": "#/$defs/calibration"},
    "input": {"$ref": "#/$defs/tensor"},
    "output": {"$ref": "#/$defs/tensor"},
    "classes": {"type": "array", "minItems": 1, "maxItems": 7, "items": {"$ref": "#/$defs/class"}},
    "frame_hop_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
    "limits": {"$ref": "#/$defs/limits"},
    "fallback": {"const": "reject"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "httpsUrl": {"type": "string", "pattern": "^https://[^\\u0000-\\u001f]+$", "minLength": 9, "maxLength": 512},
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "url", "dataset", "dataset_url"],
      "properties": {
        "spdx": {"type": "string", "minLength": 1, "maxLength": 512},
        "url": {"$ref": "#/$defs/httpsUrl"},
        "dataset": {"type": "string", "minLength": 1, "maxLength": 512},
        "dataset_url": {"$ref": "#/$defs/httpsUrl"}
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_sha256", "report_url"],
      "properties": {
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "report_url": {"$ref": "#/$defs/httpsUrl"}
      }
    },
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "shape"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 512},
        "shape": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": -1}}
      }
    },
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "confidence_threshold", "severity_threshold"],
      "properties": {
        "kind": {"enum": ["noise", "pop", "dropout", "lip-noise", "phase-cancellation", "clipping", "other"]},
        "confidence_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "severity_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_label": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_model_bytes", "max_feature_frames", "max_feature_values", "max_events", "max_inference_seconds", "intra_threads"],
      "properties": {
        "max_model_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "max_feature_frames": {"type": "integer", "minimum": 1, "maximum": 2000000},
        "max_feature_values": {"type": "integer", "minimum": 1, "maximum": 128000000},
        "max_events": {"type": "integer", "minimum": 1, "maximum": 100000},
        "max_inference_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600},
        "intra_threads": {"type": "integer", "minimum": 1, "maximum": 256}
      }
    }
  }
}
