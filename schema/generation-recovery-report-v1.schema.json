{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguin425.github.io/audio-normalizer/schema/generation-recovery-report-v1",
  "title": "Forge generation recovery report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generator",
    "action",
    "confirmed",
    "state",
    "generation_id",
    "semantic_fingerprint",
    "phase",
    "member_count",
    "publication_steps",
    "lock_state",
    "private_file_count"
  ],
  "properties": {
    "schema": {
      "const": "https://penguin425.github.io/audio-normalizer/schema/generation-recovery-report-v1"
    },
    "generator": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^forge-normalizer/[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "action": {
      "enum": [
        "inspected",
        "would_abandon_ready",
        "would_finalize_committed",
        "would_roll_back",
        "would_clean_committed",
        "nothing_to_reclaim",
        "blocked_active",
        "reclaimed"
      ]
    },
    "confirmed": {
      "type": "boolean"
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "generation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semantic_fingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!.*[\\u0000-\\u001F\\u007F-\\u009F]).+$"
    },
    "phase": {
      "enum": ["ready", "publishing", "committed", "rolled_back"]
    },
    "member_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "publication_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "enum": ["prepared", "backed_up", "published", "restored", "abandoned"]
      }
    },
    "lock_state": {
      "enum": ["not_probed", "missing", "available", "active"]
    },
    "private_file_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {"const": "reclaimed"}
        }
      },
      "then": {
        "properties": {
          "confirmed": {"const": true}
        }
      },
      "else": {
        "properties": {
          "confirmed": {"const": false}
        }
      }
    }
  ]
}
