{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguin425.github.io/audio-normalizer/schema/adm-presentation-report-v1",
  "title": "Forge ADM presentation QC report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "validator",
    "production_profile_standard",
    "renderer_standard",
    "measurement_standard",
    "input_path",
    "input_bytes",
    "input_sha256",
    "renderer_path",
    "renderer_sha256",
    "output_layout",
    "loudness_tolerance_lu",
    "true_peak_tolerance_db",
    "limits",
    "production_profile",
    "inventory",
    "presentation_count",
    "passed",
    "presentations"
  ],
  "properties": {
    "schema": {"const": "https://penguin425.github.io/audio-normalizer/schema/adm-presentation-report-v1"},
    "schema_version": {"const": 1},
    "validator": {"const": "forge-adm-presentation-qc-1"},
    "production_profile_standard": {"const": "EBU Tech 3393"},
    "renderer_standard": {"const": "ITU-R BS.2127-1"},
    "measurement_standard": {"const": "ITU-R BS.1770-5"},
    "input_path": {"type": "string", "minLength": 1},
    "input_bytes": {"type": "integer", "minimum": 1},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "renderer_path": {"type": "string", "minLength": 1},
    "renderer_sha256": {"$ref": "#/$defs/sha256"},
    "output_layout": {"type": "string", "minLength": 1, "maxLength": 64},
    "loudness_tolerance_lu": {"type": "number", "minimum": 0, "maximum": 10},
    "true_peak_tolerance_db": {"type": "number", "minimum": 0, "maximum": 10},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds_per_presentation", "max_presentations", "max_decoded_samples_per_presentation", "max_render_bytes_per_presentation", "tool_output_bytes_per_stream"],
      "properties": {
        "timeout_seconds_per_presentation": {"type": "integer", "minimum": 1, "maximum": 3600},
        "max_presentations": {"type": "integer", "minimum": 1, "maximum": 4096},
        "max_decoded_samples_per_presentation": {"type": "integer", "minimum": 1, "maximum": 4000000000},
        "max_render_bytes_per_presentation": {"type": "integer", "minimum": 1048584, "maximum": 32001048576},
        "tool_output_bytes_per_stream": {"const": 1048576}
      }
    },
    "production_profile": {"type": "object"},
    "inventory": {"$ref": "#/$defs/inventory"},
    "presentation_count": {"type": "integer", "minimum": 1, "maximum": 4096},
    "passed": {"type": "boolean"},
    "presentations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/presentation"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableNumber": {"type": ["number", "null"]},
    "nullableBoolean": {"type": ["boolean", "null"]},
    "nullableString": {"type": ["string", "null"]},
    "stringArray": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "loudness": {
      "type": ["object", "null"],
      "properties": {
        "loudness_method": {"$ref": "#/$defs/nullableString"},
        "integrated_loudness_lufs": {"$ref": "#/$defs/nullableNumber"},
        "max_true_peak_dbtp": {"$ref": "#/$defs/nullableNumber"},
        "renderer_uri": {"$ref": "#/$defs/nullableString"},
        "renderer_name": {"$ref": "#/$defs/nullableString"},
        "renderer_version": {"$ref": "#/$defs/nullableString"},
        "renderer_audio_object_ids": {"$ref": "#/$defs/stringArray"},
        "production_profile_passed": {"type": "boolean"}
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_object_id", "candidates"],
      "properties": {
        "root_object_id": {"type": "string", "minLength": 1},
        "candidates": {"$ref": "#/$defs/stringArray"}
      }
    },
    "programme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "language", "content_ids", "referenced_object_ids", "loudness_metadata", "complementary_groups", "presentation_count"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "language": {"$ref": "#/$defs/nullableString"},
        "content_ids": {"$ref": "#/$defs/stringArray"},
        "referenced_object_ids": {"$ref": "#/$defs/stringArray"},
        "loudness_metadata": {"$ref": "#/$defs/loudness"},
        "complementary_groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
        "presentation_count": {"type": "integer", "minimum": 1}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["programme_count", "content_count", "object_count", "complementary_group_count", "presentation_count", "programmes"],
      "properties": {
        "programme_count": {"type": "integer", "minimum": 1},
        "content_count": {"type": "integer", "minimum": 1},
        "object_count": {"type": "integer", "minimum": 1},
        "complementary_group_count": {"type": "integer", "minimum": 0},
        "presentation_count": {"type": "integer", "minimum": 1, "maximum": 4096},
        "programmes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/programme"}}
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "programme_id", "programme_name", "programme_language", "selected_complementary_object_ids", "declared_loudness", "rendered_sha256", "rendered_bytes", "retained_render_path", "sample_rate_hz", "channels", "duration_seconds", "measured_integrated_lufs", "measured_true_peak_dbtp", "integrated_loudness_drift_lu", "true_peak_drift_db", "loudness_metadata_passed", "true_peak_metadata_passed", "passed"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "programme_id": {"type": "string", "minLength": 1},
        "programme_name": {"type": "string", "minLength": 1},
        "programme_language": {"$ref": "#/$defs/nullableString"},
        "selected_complementary_object_ids": {"$ref": "#/$defs/stringArray"},
        "declared_loudness": {"$ref": "#/$defs/loudness"},
        "rendered_sha256": {"$ref": "#/$defs/sha256"},
        "rendered_bytes": {"type": "integer", "minimum": 1},
        "retained_render_path": {"$ref": "#/$defs/nullableString"},
        "sample_rate_hz": {"type": "integer", "minimum": 1},
        "channels": {"type": "integer", "minimum": 1},
        "duration_seconds": {"type": "number", "minimum": 0},
        "measured_integrated_lufs": {"$ref": "#/$defs/nullableNumber"},
        "measured_true_peak_dbtp": {"$ref": "#/$defs/nullableNumber"},
        "integrated_loudness_drift_lu": {"$ref": "#/$defs/nullableNumber"},
        "true_peak_drift_db": {"$ref": "#/$defs/nullableNumber"},
        "loudness_metadata_passed": {"$ref": "#/$defs/nullableBoolean"},
        "true_peak_metadata_passed": {"$ref": "#/$defs/nullableBoolean"},
        "passed": {"type": "boolean"}
      }
    }
  }
}
