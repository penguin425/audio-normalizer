{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguin425.github.io/audio-normalizer/schema/dts-adapter-request-v1",
  "title": "Forge DTS adapter request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocol_version", "input_path", "input_sha256", "input_bytes", "output_directory", "native_inventory", "requirements"],
  "properties": {
    "schema": {"const": "https://penguin425.github.io/audio-normalizer/schema/dts-adapter-request-v1"},
    "protocol_version": {"const": 1},
    "input_path": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_bytes": {"type": "integer", "minimum": 1},
    "output_directory": {"type": "string", "minLength": 1},
    "native_inventory": {"$ref": "#/$defs/inventory"},
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enumerate_all_assets", "enumerate_all_presentations", "render_every_presentation_once", "rendered_format", "dialog_normalization", "dynamic_range_control", "standard"],
      "properties": {
        "enumerate_all_assets": {"const": true},
        "enumerate_all_presentations": {"const": true},
        "render_every_presentation_once": {"const": true},
        "rendered_format": {"const": "wave"},
        "dialog_normalization": {"const": "disable-or-report"},
        "dynamic_range_control": {"const": "disable-or-report"},
        "standard": {"const": "ETSI TS 102 114 V1.6.1 (2019-08)"}
      }
    }
  },
  "$defs": {
    "inventory": {
      "type": "object", "additionalProperties": false,
      "required": ["stream_bytes", "frame_count", "core_frame_count", "extension_substream_count", "padding_bytes", "core_sample_blocks", "wire_formats", "core_configurations", "extension_substreams", "declared_presentation_count", "declared_asset_count"],
      "properties": {
        "stream_bytes": {"type": "integer", "minimum": 1},
        "frame_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "core_frame_count": {"type": "integer", "minimum": 0},
        "extension_substream_count": {"type": "integer", "minimum": 0},
        "padding_bytes": {"type": "integer", "minimum": 0},
        "core_sample_blocks": {"type": "integer", "minimum": 0},
        "wire_formats": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/wire_format"}},
        "core_configurations": {"type": "array", "maxItems": 1000000, "items": {"$ref": "#/$defs/core_configuration"}},
        "extension_substreams": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/exss"}},
        "declared_presentation_count": {"type": "integer", "minimum": 1, "maximum": 8},
        "declared_asset_count": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "wire_format": {
      "type": "object", "additionalProperties": false, "required": ["format", "count"],
      "properties": {
        "format": {"enum": ["sixteen-bit-big-endian", "sixteen-bit-little-endian", "fourteen-bit-big-endian", "fourteen-bit-little-endian"]},
        "count": {"type": "integer", "minimum": 1}
      }
    },
    "core_configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_rate_hz", "sample_blocks", "audio_mode", "channels", "lfe_mode", "bit_rate_code", "bit_rate_bps", "pcm_resolution_bits", "extension_audio_present", "extension_audio_type", "extension_audio_name", "dialog_normalization_code", "count"],
      "properties": {
        "sample_rate_hz": {"type": "integer", "minimum": 8000, "maximum": 192000},
        "sample_blocks": {"type": "integer", "minimum": 8, "maximum": 128, "multipleOf": 8},
        "audio_mode": {"type": "integer", "minimum": 0, "maximum": 15},
        "channels": {"type": "integer", "minimum": 1, "maximum": 9},
        "lfe_mode": {"type": "integer", "minimum": 0, "maximum": 2},
        "bit_rate_code": {"type": "integer", "minimum": 0, "maximum": 31},
        "bit_rate_bps": {"type": ["integer", "null"], "minimum": 1},
        "pcm_resolution_bits": {"enum": [16, 20, 24]},
        "extension_audio_present": {"type": "boolean"},
        "extension_audio_type": {"type": "integer", "minimum": 0, "maximum": 7},
        "extension_audio_name": {"type": "string", "minLength": 1},
        "dialog_normalization_code": {"type": ["integer", "null"], "minimum": 0, "maximum": 15},
        "count": {"type": "integer", "minimum": 1}
      }
    },
    "exss": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "count", "static_header_count", "maximum_presentations", "maximum_assets"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 3},
        "count": {"type": "integer", "minimum": 1},
        "static_header_count": {"type": "integer", "minimum": 0},
        "maximum_presentations": {"type": "integer", "minimum": 0, "maximum": 8},
        "maximum_assets": {"type": "integer", "minimum": 0, "maximum": 8}
      }
    }
  }
}
