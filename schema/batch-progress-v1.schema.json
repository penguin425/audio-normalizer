{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguin425.github.io/audio-normalizer/schema/batch-progress-v1",
  "title": "Forge batch progress event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generator",
    "sequence",
    "event",
    "completed",
    "total"
  ],
  "properties": {
    "schema": {
      "const": "https://penguin425.github.io/audio-normalizer/schema/batch-progress-v1"
    },
    "generator": {
      "type": "string",
      "pattern": "^forge-normalizer/[0-9]+\\.[0-9]+\\.[0-9]+"
    },
    "sequence": {"type": "integer", "minimum": 0},
    "event": {
      "enum": [
        "job_started",
        "asset_started",
        "asset_completed",
        "asset_skipped",
        "asset_failed",
        "job_completed"
      ]
    },
    "completed": {"type": "integer", "minimum": 0},
    "total": {"type": "integer", "minimum": 1, "maximum": 100000},
    "index": {"type": "integer", "minimum": 0, "maximum": 99999},
    "input": {"type": "string", "minLength": 1},
    "output": {"type": "string", "minLength": 1},
    "error": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "enum": [
              "asset_started",
              "asset_completed",
              "asset_skipped",
              "asset_failed"
            ]
          }
        }
      },
      "then": {"required": ["index", "input", "output"]}
    },
    {
      "if": {"properties": {"event": {"const": "asset_failed"}}},
      "then": {"required": ["error"]},
      "else": {"not": {"required": ["error"]}}
    }
  ]
}
