{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguin425.github.io/audio-normalizer/schema/adm-emission-report-v1",
  "title": "Forge ADM emission QC report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "validator",
    "standard",
    "profile_name",
    "profile_version",
    "profile_level",
    "input_path",
    "input_bytes",
    "input_sha256",
    "axml_bytes",
    "chna_bytes",
    "wave_container",
    "axml_chunks",
    "chna_chunks",
    "data_bytes",
    "ds64_sample_count",
    "limits",
    "counts",
    "passed",
    "rendered_audio_verified",
    "scope_note",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "https://penguin425.github.io/audio-normalizer/schema/adm-emission-report-v1"
    },
    "schema_version": {"const": 1},
    "validator": {"const": "forge-bs2168-0-file-1"},
    "standard": {"const": "ITU-R BS.2168-0"},
    "profile_name": {
      "const": "Advanced sound system: ADM and S-ADM profile for emission"
    },
    "profile_version": {"const": "1"},
    "profile_level": {"enum": [0, 1, 2]},
    "input_path": {"type": "string", "minLength": 1},
    "input_bytes": {"type": "integer", "minimum": 1},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "axml_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
    "chna_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
    "wave_container": {"enum": ["RIFF", "RF64", "BW64"]},
    "axml_chunks": {"type": "integer", "minimum": 0, "maximum": 100000},
    "chna_chunks": {"type": "integer", "minimum": 0, "maximum": 100000},
    "data_bytes": {"type": "integer", "minimum": 0},
    "ds64_sample_count": {"type": ["integer", "null"], "minimum": 0},
    "limits": {"$ref": "#/$defs/limits"},
    "counts": {"$ref": "#/$defs/counts"},
    "passed": {"type": "boolean"},
    "rendered_audio_verified": {"const": false},
    "scope_note": {
      "const": "File-based ADM metadata and PCM/chna reconciliation only; this report does not render audio or validate S-ADM frame rules."
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250000,
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"wave_container": {"const": "RF64"}}},
      "then": {"properties": {"ds64_sample_count": {"type": "integer", "minimum": 0}}},
      "else": {"properties": {"ds64_sample_count": {"type": "null"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableLimit": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 1000000
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_axml_bytes",
        "max_chna_bytes",
        "max_xml_nodes",
        "max_xml_depth",
        "max_attributes_per_element",
        "max_xml_text_bytes",
        "max_report_items",
        "max_evidence_items",
        "max_programmes",
        "max_contents",
        "max_objects",
        "max_pack_formats",
        "max_channel_formats",
        "max_track_uids",
        "max_non_complementary_tracks",
        "max_complementary_groups",
        "max_independent_groups",
        "max_channels_per_layout",
        "max_programme_content_refs",
        "max_programme_alternative_value_set_refs",
        "max_programme_labels",
        "max_content_labels",
        "max_object_child_refs",
        "max_object_complementary_refs",
        "max_object_alternative_value_sets",
        "max_object_group_labels"
      ],
      "properties": {
        "max_axml_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "max_chna_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "max_xml_nodes": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_xml_depth": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_attributes_per_element": {"type": "integer", "minimum": 1, "maximum": 4096},
        "max_xml_text_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "max_report_items": {"type": "integer", "minimum": 12, "maximum": 250000},
        "max_evidence_items": {"type": "integer", "minimum": 1, "maximum": 4096},
        "max_programmes": {"$ref": "#/$defs/nullableLimit"},
        "max_contents": {"$ref": "#/$defs/nullableLimit"},
        "max_objects": {"$ref": "#/$defs/nullableLimit"},
        "max_pack_formats": {"$ref": "#/$defs/nullableLimit"},
        "max_channel_formats": {"$ref": "#/$defs/nullableLimit"},
        "max_track_uids": {"$ref": "#/$defs/nullableLimit"},
        "max_non_complementary_tracks": {"$ref": "#/$defs/nullableLimit"},
        "max_complementary_groups": {"$ref": "#/$defs/nullableLimit"},
        "max_independent_groups": {"$ref": "#/$defs/nullableLimit"},
        "max_channels_per_layout": {"$ref": "#/$defs/nullableLimit"},
        "max_programme_content_refs": {"$ref": "#/$defs/nullableLimit"},
        "max_programme_alternative_value_set_refs": {"$ref": "#/$defs/nullableLimit"},
        "max_programme_labels": {"$ref": "#/$defs/nullableLimit"},
        "max_content_labels": {"$ref": "#/$defs/nullableLimit"},
        "max_object_child_refs": {"$ref": "#/$defs/nullableLimit"},
        "max_object_complementary_refs": {"$ref": "#/$defs/nullableLimit"},
        "max_object_alternative_value_sets": {"$ref": "#/$defs/nullableLimit"},
        "max_object_group_labels": {"$ref": "#/$defs/nullableLimit"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xml_nodes",
        "programmes",
        "contents",
        "objects",
        "pack_formats",
        "matrix_pack_formats",
        "channel_formats",
        "matrix_channel_formats",
        "block_formats",
        "track_uids",
        "alternative_value_sets",
        "complementary_groups",
        "non_complementary_tracks",
        "independent_groups",
        "report_items"
      ],
      "properties": {
        "xml_nodes": {"$ref": "#/$defs/count"},
        "programmes": {"$ref": "#/$defs/count"},
        "contents": {"$ref": "#/$defs/count"},
        "objects": {"$ref": "#/$defs/count"},
        "pack_formats": {"$ref": "#/$defs/count"},
        "matrix_pack_formats": {"$ref": "#/$defs/count"},
        "channel_formats": {"$ref": "#/$defs/count"},
        "matrix_channel_formats": {"$ref": "#/$defs/count"},
        "block_formats": {"$ref": "#/$defs/count"},
        "track_uids": {"$ref": "#/$defs/count"},
        "alternative_value_sets": {"$ref": "#/$defs/count"},
        "complementary_groups": {"$ref": "#/$defs/count"},
        "non_complementary_tracks": {"$ref": "#/$defs/count"},
        "independent_groups": {"$ref": "#/$defs/count"},
        "report_items": {"$ref": "#/$defs/count"}
      }
    },
    "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "authority",
        "section",
        "subject",
        "requirement",
        "observed",
        "passed",
        "evidence_truncated",
        "evidence"
      ],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^BS(?:2168|2088)-[A-Z0-9.\\-]+$"},
        "authority": {"enum": ["ITU-R BS.2168-0", "ITU-R BS.2088-2"]},
        "section": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "requirement": {"type": "string", "minLength": 1},
        "observed": {"type": "string"},
        "passed": {"type": "boolean"},
        "evidence_truncated": {"type": "boolean"},
        "evidence": {
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "observed"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "observed": {"type": "string"}
      }
    }
  }
}
