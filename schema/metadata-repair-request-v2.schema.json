{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguin425.github.io/audio-normalizer/schema/metadata-repair-request-v2.schema.json",
  "title": "Forge metadata repair request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "destination"],
  "properties": {
    "schema_version": {"const": 2},
    "source": {"type": "string", "minLength": 1},
    "destination": {"type": "string", "minLength": 1},
    "mode": {"enum": ["validate", "repair"]},
    "ensure_bwf_v2": {"type": "boolean"},
    "bwf_loudness": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "integrated_lufs",
        "loudness_range_lu",
        "true_peak_dbtp",
        "max_momentary_lufs",
        "max_short_term_lufs"
      ],
      "properties": {
        "integrated_lufs": {"type": "number", "minimum": -120, "maximum": 6},
        "loudness_range_lu": {"type": "number", "minimum": 0, "maximum": 50},
        "true_peak_dbtp": {"type": "number", "minimum": -120, "maximum": 6},
        "max_momentary_lufs": {"type": "number", "minimum": -120, "maximum": 6},
        "max_short_term_lufs": {"type": "number", "minimum": -120, "maximum": 6}
      }
    },
    "adm_version": {"type": ["string", "null"], "enum": ["ITU-R_BS.2076-3", null]},
    "isobmff_loudness": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "decoded_reference": {"type": ["string", "null"], "minLength": 1},
        "album_decoded_references": {
          "type": ["array", "null"],
          "minItems": 1,
          "maxItems": 10000,
          "items": {"type": "string", "minLength": 1},
          "description": "Complete ordered album; must contain decoded_reference (or source) exactly once."
        },
        "max_album_references": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_decoded_samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000000000,
          "description": "Aggregate decoded-sample limit across unique album references."
        }
      }
    },
    "overwrite": {"type": "boolean"},
    "atomic_replace": {"type": "boolean"},
    "max_input_bytes": {
      "type": "integer",
      "minimum": 1,
      "description": "For album repair, the aggregate byte limit across unique decoded references."
    },
    "max_output_bytes": {"type": "integer", "minimum": 1},
    "max_metadata_chunk_bytes": {"type": "integer", "minimum": 1},
    "max_xml_bytes": {"type": "integer", "minimum": 1},
    "max_chunks": {"type": "integer", "minimum": 1}
  }
}
