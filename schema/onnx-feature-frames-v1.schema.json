{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguin425.github.io/audio-normalizer/schema/onnx-feature-frames-v1",
  "title": "Forge ONNX feature-frame input v1",
  "description": "Bounded, provenance-bound float32 feature frames consumed by the optional ONNX adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "source_path", "source_sha256",
    "source_duration_seconds", "sample_rate_hz", "frame_hop_seconds",
    "feature_count", "frames"
  ],
  "properties": {
    "schema": {"const": "https://penguin425.github.io/audio-normalizer/schema/onnx-feature-frames-v1"},
    "schema_version": {"const": 1},
    "source_path": {"type": "string", "minLength": 1, "maxLength": 1024},
    "source_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "source_duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 604800},
    "sample_rate_hz": {"type": "integer", "minimum": 1},
    "frame_hop_seconds": {"type": "number", "exclusiveMinimum": 0},
    "feature_count": {"type": "integer", "minimum": 1, "maximum": 4096},
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000000,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4096,
        "items": {"type": "number"}
      }
    }
  }
}
