{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguin425.github.io/audio-normalizer/schema/segment-normalization-request-v1",
  "title": "Forge segment normalization request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "format", "segments"],
  "properties": {
    "schema": {"const": "https://penguin425.github.io/audio-normalizer/schema/segment-normalization-request-v1"},
    "target_lufs": {"type": "number", "minimum": -100, "maximum": 0, "default": -16},
    "ceiling_dbtp": {"type": "number", "minimum": -20, "maximum": 0, "default": -1},
    "max_gain_db": {"type": ["number", "null"], "minimum": -120, "maximum": 60},
    "smoothing_ms": {"type": "number", "minimum": 1, "maximum": 10000, "default": 500},
    "verification_tolerance_lu_db": {"type": "number", "minimum": 0, "maximum": 5, "default": 0.5},
    "duration_tolerance_ms": {"type": "number", "minimum": 0, "maximum": 10000, "default": 100},
    "boundary_review_threshold_db": {"type": "number", "minimum": 0, "maximum": 60, "default": 6},
    "max_decoded_samples_per_segment": {"type": "integer", "minimum": 1, "maximum": 200000000, "default": 50000000},
    "format": {"enum": ["wav", "flac", "mp3", "opus", "m4a", "alac", "vorbis"]},
    "mp3_bitrate_kbps": {"type": "integer", "minimum": 8, "maximum": 320, "default": 320},
    "mp3_quality": {"type": "integer", "minimum": 0, "maximum": 9, "default": 2},
    "segments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "output"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$"},
          "input": {"type": "string", "minLength": 1},
          "output": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
