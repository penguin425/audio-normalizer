{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguin425.github.io/audio-normalizer/schema/mpegh-adapter-report-v1",
  "title": "Forge MPEG-H adapter report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocol_version", "validator", "input_path", "input_bytes", "input_sha256", "adapter_path", "adapter_sha256", "decoder", "core_standard", "reference_software_standard", "conformance_standard", "mhas_inventory", "profile_level", "scene", "timeout_seconds", "max_decoded_samples_per_presentation", "loudness_tolerance_lu", "max_true_peak_dbtp", "presentation_count", "passed", "presentations"],
  "properties": {
    "schema": {"const": "https://penguin425.github.io/audio-normalizer/schema/mpegh-adapter-report-v1"},
    "protocol_version": {"const": 1},
    "validator": {"const": "forge-mpegh-reference-adapter-1"},
    "input_path": {"type": "string", "minLength": 1},
    "input_bytes": {"type": "integer", "minimum": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter_path": {"type": "string", "minLength": 1},
    "adapter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decoder": {"$ref": "#/$defs/decoder"},
    "core_standard": {"const": "ISO/IEC 23008-3:2026"},
    "reference_software_standard": {"const": "ISO/IEC 23008-6:2025"},
    "conformance_standard": {"const": "ISO/IEC 23008-9:2023"},
    "mhas_inventory": {"$ref": "#/$defs/inventory"},
    "profile_level": {"$ref": "#/$defs/profile_level"},
    "scene": {"$ref": "#/$defs/scene"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "max_decoded_samples_per_presentation": {"type": "integer", "minimum": 1, "maximum": 200000000},
    "loudness_tolerance_lu": {"type": "number", "minimum": 0, "maximum": 10},
    "max_true_peak_dbtp": {"type": ["number", "null"], "minimum": -100, "maximum": 0},
    "presentation_count": {"type": "integer", "minimum": 1, "maximum": 33},
    "passed": {"type": "boolean"},
    "presentations": {"type": "array", "minItems": 1, "maxItems": 33, "items": {"$ref": "#/$defs/result"}}
  },
  "$defs": {
    "decoder": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 128}, "version": {"type": "string", "minLength": 1, "maxLength": 128}}
    },
    "inventory": {
      "type": "object", "additionalProperties": false,
      "required": ["packet_count", "payload_bytes", "packet_types", "labels", "configuration_count", "frame_count", "audio_scene_info_count", "loudness_drc_count", "loudness_count", "sync_count", "profile_levels"],
      "properties": {
        "packet_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "payload_bytes": {"type": "integer", "minimum": 1},
        "packet_types": {"type": "array", "minItems": 2, "maxItems": 518, "items": {"$ref": "#/$defs/packet_type"}},
        "labels": {"type": "array", "minItems": 1, "maxItems": 1000000, "items": {"type": "integer", "minimum": 0}},
        "configuration_count": {"type": "integer", "minimum": 1},
        "frame_count": {"type": "integer", "minimum": 1},
        "audio_scene_info_count": {"type": "integer", "minimum": 0},
        "loudness_drc_count": {"type": "integer", "minimum": 0},
        "loudness_count": {"type": "integer", "minimum": 0},
        "sync_count": {"type": "integer", "minimum": 0},
        "profile_levels": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/profile_level"}}
      }
    },
    "packet_type": {
      "type": "object", "additionalProperties": false, "required": ["packet_type", "name", "count"],
      "properties": {
        "packet_type": {"type": "integer", "minimum": 0, "maximum": 517},
        "name": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 1}
      }
    },
    "profile_level": {
      "type": "object", "additionalProperties": false, "required": ["indication", "profile", "level"],
      "properties": {
        "indication": {"type": "integer", "minimum": 1, "maximum": 20},
        "profile": {"enum": ["main", "high", "low-complexity", "baseline"]},
        "level": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "scene": {
      "type": "object", "additionalProperties": false,
      "required": ["group_count", "groups", "switch_group_count", "switch_groups", "preset_count", "presets"],
      "properties": {
        "group_count": {"type": "integer", "minimum": 0, "maximum": 128},
        "groups": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/group"}},
        "switch_group_count": {"type": "integer", "minimum": 0, "maximum": 32},
        "switch_groups": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/switch_group"}},
        "preset_count": {"type": "integer", "minimum": 0, "maximum": 32},
        "presets": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/preset"}}
      }
    },
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "signal_kind", "allow_on_off", "default_on", "language", "content_kind", "allow_gain_interactivity", "min_gain_db", "max_gain_db", "allow_position_interactivity"],
      "properties": {
        "id": {"type": "integer", "minimum": 0, "maximum": 127},
        "signal_kind": {"enum": ["channels", "objects", "hoa"]},
        "allow_on_off": {"type": "boolean"},
        "default_on": {"type": "boolean"},
        "language": {"type": ["string", "null"], "maxLength": 35},
        "content_kind": {"type": ["string", "null"], "maxLength": 64},
        "allow_gain_interactivity": {"type": "boolean"},
        "min_gain_db": {"type": ["number", "null"], "minimum": -128, "maximum": 0},
        "max_gain_db": {"type": ["number", "null"], "minimum": 0, "maximum": 128},
        "allow_position_interactivity": {"type": "boolean"}
      }
    },
    "switch_group": {
      "type": "object", "additionalProperties": false, "required": ["id", "group_ids", "default_group_id"],
      "properties": {
        "id": {"type": "integer", "minimum": 0, "maximum": 31},
        "group_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 127}},
        "default_group_id": {"type": "integer", "minimum": 0, "maximum": 127}
      }
    },
    "preset": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "group_ids"],
      "properties": {
        "id": {"type": "integer", "minimum": 0, "maximum": 31},
        "name": {"type": ["string", "null"], "maxLength": 128},
        "kind": {"type": "integer", "minimum": 0, "maximum": 31},
        "group_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 127}}
      }
    },
    "loudness": {
      "type": "object", "additionalProperties": false,
      "required": ["loudness_info_type", "mae_group_id", "mae_group_preset_id", "method_definition", "program_loudness_lkfs", "drc_set_id", "downmix_id", "measurement_system"],
      "properties": {
        "loudness_info_type": {"enum": [0, 3]},
        "mae_group_id": {"type": ["integer", "null"], "minimum": 0, "maximum": 127},
        "mae_group_preset_id": {"type": ["integer", "null"], "minimum": 0, "maximum": 31},
        "method_definition": {"enum": [1, 2]},
        "program_loudness_lkfs": {"type": "number", "minimum": -70, "maximum": 0},
        "drc_set_id": {"const": 0},
        "downmix_id": {"const": 0},
        "measurement_system": {"type": ["string", "null"], "maxLength": 64}
      },
      "allOf": [
        {"if": {"properties": {"loudness_info_type": {"const": 0}}}, "then": {"properties": {"mae_group_id": {"type": "null"}, "mae_group_preset_id": {"type": "null"}}}},
        {"if": {"properties": {"loudness_info_type": {"const": 3}}}, "then": {"properties": {"mae_group_id": {"type": "null"}, "mae_group_preset_id": {"type": "integer", "minimum": 0, "maximum": 31}}}}
      ]
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "preset_id", "output_layout", "language", "accessibility", "loudness_metadata", "rendered_sha256", "rendered_bytes", "sample_rate_hz", "channels", "duration_seconds", "measured_integrated_lufs", "measured_true_peak_dbtp", "loudness_drift_lu", "loudness_passed", "true_peak_passed", "passed", "checks"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
        "preset_id": {"type": ["integer", "null"], "minimum": 0, "maximum": 31},
        "output_layout": {"type": "string", "minLength": 1, "maxLength": 64},
        "language": {"type": ["string", "null"], "maxLength": 35},
        "accessibility": {"type": ["string", "null"], "maxLength": 64},
        "loudness_metadata": {"$ref": "#/$defs/loudness"},
        "rendered_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rendered_bytes": {"type": "integer", "minimum": 1},
        "sample_rate_hz": {"type": "integer", "minimum": 1},
        "channels": {"type": "integer", "minimum": 1},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "measured_integrated_lufs": {"type": "number"},
        "measured_true_peak_dbtp": {"type": "number"},
        "loudness_drift_lu": {"type": "number"},
        "loudness_passed": {"type": "boolean"},
        "true_peak_passed": {"type": ["boolean", "null"]},
        "passed": {"type": "boolean"},
        "checks": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/check"}}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "standard", "measured", "maximum", "unit", "passed"],
      "properties": {
        "rule_id": {"enum": ["FORGE-MPEGH-PROGRAM-LOUDNESS-MATCH", "FORGE-MPEGH-TRUE-PEAK"]},
        "standard": {"type": "string", "minLength": 1},
        "measured": {"type": "number"},
        "maximum": {"type": "number"},
        "unit": {"enum": ["LU", "dBTP"]},
        "passed": {"type": "boolean"}
      }
    }
  }
}
