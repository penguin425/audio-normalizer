{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguin425.github.io/audio-normalizer/schema/multi-delivery-request-v1.schema.json",
  "title": "Forge multi-delivery request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "deliveries"],
  "properties": {
    "schema": {
      "const": "https://penguin425.github.io/audio-normalizer/schema/multi-delivery-request-v1"
    },
    "verify_tolerance_lu_db": {"type": "number", "minimum": 0},
    "verify_retries": {"type": "integer", "minimum": 0, "maximum": 10},
    "max_gain_db": {"type": ["number", "null"]},
    "mp3_bitrate_kbps": {"type": "integer", "minimum": 8, "maximum": 320},
    "mp3_quality": {"type": "integer", "minimum": 0, "maximum": 9},
    "deliveries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/delivery"}
    }
  },
  "$defs": {
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "output", "format", "preset"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "output": {"type": "string", "minLength": 1},
        "format": {
          "enum": ["wav", "flac", "mp3", "opus", "m4a", "alac", "vorbis"]
        },
        "preset": {
          "enum": [
            "spotify",
            "spotify-normal-2026-07-30",
            "apple-music",
            "apple-music-reference-2026-07-30",
            "youtube",
            "youtube-reference-2026-07-30",
            "podcast-stereo",
            "podcast-mono",
            "ebu-r128",
            "atsc-a85",
            "arib-tr-b32"
          ]
        }
      }
    }
  }
}
