{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/audio-normalizer/schema/downmix-qc-report-v1.schema.json",
  "title": "Forge immersive downmix QC report v1",
  "description": "Loudness, peak, matrix, and clip-risk evidence for deterministic WAVE-order downmix profiles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "validator", "source", "input_layout",
    "true_peak_ceiling_dbtp", "max_clipped_samples",
    "max_loudness_delta_lu", "max_true_peak_delta_db",
    "source_measurement", "profiles", "passed"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "validator": {"const": "forge-immersive-downmix-qc-1"},
    "source": {"type": "string", "minLength": 1},
    "input_layout": {
      "enum": ["mono", "stereo", "5.1", "6.1", "7.1", "5.1.4", "7.1.4"]
    },
    "true_peak_ceiling_dbtp": {"type": "number", "minimum": -120, "maximum": 6},
    "max_clipped_samples": {"type": "integer", "minimum": 0},
    "max_loudness_delta_lu": {"type": ["number", "null"], "minimum": 0},
    "max_true_peak_delta_db": {"type": ["number", "null"], "minimum": 0},
    "source_measurement": {"$ref": "#/$defs/measurement"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/profile_result"}
    },
    "passed": {"type": "boolean"}
  },
  "$defs": {
    "finite_or_null": {"type": ["number", "null"]},
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout", "channels", "sample_rate_hz", "frames", "duration_seconds",
        "integrated_lufs", "loudness_range_lu", "sample_peak_dbfs", "true_peak_dbtp"
      ],
      "properties": {
        "layout": {"enum": ["mono", "stereo", "5.1", "6.1", "7.1", "5.1.4", "7.1.4"]},
        "channels": {"type": "integer", "minimum": 1},
        "sample_rate_hz": {"type": "integer", "minimum": 1},
        "frames": {"type": "integer", "minimum": 0},
        "duration_seconds": {"type": "number", "minimum": 0},
        "integrated_lufs": {"$ref": "#/$defs/finite_or_null"},
        "loudness_range_lu": {"$ref": "#/$defs/finite_or_null"},
        "sample_peak_dbfs": {"$ref": "#/$defs/finite_or_null"},
        "true_peak_dbtp": {"$ref": "#/$defs/finite_or_null"}
      }
    },
    "matrix_term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_channel", "input_label", "coefficient"],
      "properties": {
        "input_channel": {"type": "integer", "minimum": 1},
        "input_label": {"type": "string", "minLength": 1},
        "coefficient": {"type": "number"}
      }
    },
    "matrix_channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_channel", "output_label", "terms"],
      "properties": {
        "output_channel": {"type": "integer", "minimum": 1},
        "output_label": {"type": "string", "minLength": 1},
        "terms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/matrix_term"}}
      }
    },
    "profile_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile", "target_layout", "method", "mapping", "measurement",
        "loudness_delta_lu", "true_peak_delta_db", "sample_peak_delta_db",
        "clipped_samples", "maximum_sample", "headroom_to_ceiling_db",
        "clip_risk", "loudness_delta_passed", "true_peak_delta_passed",
        "clip_risk_passed", "passed"
      ],
      "properties": {
        "profile": {"enum": ["stereo", "5.1", "7.1.4"]},
        "target_layout": {"enum": ["stereo", "5.1", "7.1.4"]},
        "method": {"type": "string", "minLength": 1},
        "mapping": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/matrix_channel"}},
        "measurement": {"$ref": "#/$defs/measurement"},
        "loudness_delta_lu": {"$ref": "#/$defs/finite_or_null"},
        "true_peak_delta_db": {"$ref": "#/$defs/finite_or_null"},
        "sample_peak_delta_db": {"$ref": "#/$defs/finite_or_null"},
        "clipped_samples": {"type": "integer", "minimum": 0},
        "maximum_sample": {"type": "number", "minimum": 0},
        "headroom_to_ceiling_db": {"$ref": "#/$defs/finite_or_null"},
        "clip_risk": {"enum": ["none", "true-peak-ceiling", "sample-clipping"]},
        "loudness_delta_passed": {"type": "boolean"},
        "true_peak_delta_passed": {"type": "boolean"},
        "clip_risk_passed": {"type": "boolean"},
        "passed": {"type": "boolean"}
      }
    }
  }
}
