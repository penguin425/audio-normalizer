{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguin425.github.io/audio-normalizer/schema/dts-adapter-response-v1",
  "title": "Forge DTS adapter response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocol_version", "input_sha256", "decoder", "standard", "profile", "dialog_normalization_policy", "dynamic_range_control_policy", "asset_count", "assets", "presentation_count", "presentations"],
  "properties": {
    "schema": {"const": "https://penguin425.github.io/audio-normalizer/schema/dts-adapter-response-v1"},
    "protocol_version": {"const": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "decoder": {"$ref": "#/$defs/decoder"},
    "standard": {"const": "ETSI TS 102 114 V1.6.1 (2019-08)"},
    "profile": {"$ref": "#/$defs/profile"},
    "dialog_normalization_policy": {"$ref": "#/$defs/policy"},
    "dynamic_range_control_policy": {"$ref": "#/$defs/policy"},
    "asset_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "assets": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/asset"}},
    "presentation_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "presentations": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/presentation"}}
  },
  "$defs": {
    "decoder": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 128}, "version": {"type": "string", "minLength": 1, "maxLength": 128}}},
    "profile": {"enum": ["core", "es", "96-24", "high-resolution", "master-audio", "express"]},
    "policy": {"enum": ["disabled", "applied", "not-supported"]},
    "component": {"enum": ["core", "xch", "xxch", "x96", "xbr", "lbr", "xll"]},
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "asset_index", "channels", "maximum_sample_rate_hz", "pcm_resolution_bits", "coding_components"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
        "extension_substream_index": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
        "asset_index": {"type": "integer", "minimum": 0, "maximum": 7},
        "language": {"type": ["string", "null"], "maxLength": 35},
        "channels": {"type": "integer", "minimum": 1, "maximum": 256},
        "maximum_sample_rate_hz": {"type": "integer", "minimum": 8000, "maximum": 384000},
        "pcm_resolution_bits": {"type": "integer", "minimum": 1, "maximum": 32},
        "coding_components": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/component"}},
        "dialog_normalization_db": {"type": ["number", "null"], "minimum": -31, "maximum": 0}
      }
    },
    "presentation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "asset_ids", "rendered_path", "output_layout", "declared_sample_rate_hz", "declared_channels"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
        "asset_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"}},
        "rendered_path": {"type": "string", "pattern": "^[^/\\\\].*\\.wav$"},
        "output_layout": {"type": "string", "minLength": 1, "maxLength": 64},
        "declared_sample_rate_hz": {"type": "integer", "minimum": 8000, "maximum": 384000},
        "declared_channels": {"type": "integer", "minimum": 1, "maximum": 256},
        "language": {"type": ["string", "null"], "maxLength": 35},
        "accessibility": {"type": ["string", "null"], "maxLength": 64}
      }
    }
  }
}
