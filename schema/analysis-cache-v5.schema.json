{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguin425.github.io/audio-normalizer/schema/analysis-cache-v5",
  "title": "Forge input-descriptor-bound analysis cache entry v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "generator", "measurement_standard", "algorithm_revision",
    "created_unix_seconds", "input_sha256", "request_sha256", "request",
    "result_sha256", "result"
  ],
  "properties": {
    "schema": {"const": "https://penguin425.github.io/audio-normalizer/schema/analysis-cache-v5"},
    "generator": {"type": "string", "minLength": 1, "maxLength": 256},
    "measurement_standard": {"const": "ITU-R BS.1770-5 / EBU R 128"},
    "algorithm_revision": {"const": "forge-bs1770-5-r4"},
    "created_unix_seconds": {"type": "integer", "minimum": 0},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "request": {
      "oneOf": [
        {"$ref": "#/$defs/range_request"},
        {"$ref": "#/$defs/output_domain_request"}
      ]
    },
    "result_sha256": {"$ref": "#/$defs/sha256"},
    "result": {"$ref": "#/$defs/result"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "db_value": {
      "oneOf": [
        {"type": "number"},
        {"const": "-inf"}
      ]
    },
    "optional_db_value": {
      "oneOf": [
        {"$ref": "#/$defs/db_value"},
        {"type": "null"}
      ]
    },
    "channel_role": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role"],
          "properties": {
            "role": {"enum": ["main", "surround", "dual_mono", "lfe"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "azimuth_degrees", "elevation_degrees"],
          "properties": {
            "role": {"const": "positioned"},
            "azimuth_degrees": {"type": "integer", "minimum": -32768, "maximum": 32767},
            "elevation_degrees": {"type": "integer", "minimum": -32768, "maximum": 32767}
          }
        }
      ]
    },
    "descriptor_role": {
      "oneOf": [
        {"enum": ["main", "surround", "dual-mono", "lfe"]},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["positioned"],
          "properties": {
            "positioned": {
              "type": "object",
              "additionalProperties": false,
              "required": ["azimuth_degrees", "elevation_degrees"],
              "properties": {
                "azimuth_degrees": {"type": "integer", "minimum": -180, "maximum": 180},
                "elevation_degrees": {"type": "integer", "minimum": -90, "maximum": 90}
              }
            }
          }
        }
      ]
    },
    "channel_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "role"],
      "properties": {
        "kind": {
          "enum": [
            "speaker", "low-frequency-effects", "legacy-role", "unassigned",
            "ambisonic", "object"
          ]
        },
        "role": {"$ref": "#/$defs/descriptor_role"},
        "cicp_position": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 31},
            {"type": "integer", "minimum": 36, "maximum": 42},
            {"const": 126}
          ]
        },
        "azimuth_degrees": {"type": "integer", "minimum": -180, "maximum": 180},
        "elevation_degrees": {"type": "integer", "minimum": -90, "maximum": 90},
        "component_index": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    },
    "iso_bmff_layout_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "stream_structure", "format_ordering", "raw_chnl_sha256",
        "dmix_sha256"
      ],
      "properties": {
        "version": {"type": "integer", "minimum": 0, "maximum": 1},
        "stream_structure": {"type": "integer", "minimum": 1, "maximum": 3},
        "format_ordering": {"type": "integer", "minimum": 0, "maximum": 2},
        "base_channel_count": {"type": "integer", "minimum": 0, "maximum": 255},
        "defined_layout": {"type": "integer", "minimum": 0, "maximum": 255},
        "channel_order_definition": {"type": "integer", "minimum": 0, "maximum": 4},
        "omitted_channels_map": {"type": "integer", "minimum": 0},
        "object_count": {"type": "integer", "minimum": 0, "maximum": 255},
        "raw_chnl_sha256": {"$ref": "#/$defs/sha256"},
        "dmix_sha256": {
          "type": "array",
          "maxItems": 1024,
          "items": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "renderer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renderer", "version", "output_configuration", "executable_sha256",
        "settings_sha256"
      ],
      "properties": {
        "renderer": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 256},
        "output_configuration": {"type": "string", "minLength": 1, "maxLength": 1024},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "settings_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "channel_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "assignments", "provenance", "origin"],
      "properties": {
        "version": {"const": 1},
        "assignments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {"$ref": "#/$defs/channel_assignment"}
        },
        "provenance": {"enum": ["known-speakers", "unknown", "scene-based"]},
        "origin": {
          "enum": [
            "compatibility-default", "wave", "flac", "iso-bmff", "decoder",
            "explicit-override", "renderer"
          ]
        },
        "wave_channel_mask": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "flac_channel_mask": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "iso_bmff": {"$ref": "#/$defs/iso_bmff_layout_evidence"},
        "renderer": {"$ref": "#/$defs/renderer_binding"}
      }
    },
    "input_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "decoder_route", "container", "codec", "audio_track_index",
        "audio_track_id", "source_start_frame", "source_frames", "sample_rate_hz",
        "channels", "channel_roles", "declared_layout_provenance",
        "explicit_channel_roles", "declared_channel_layout",
        "effective_channel_layout", "explicit_channel_layout"
      ],
      "properties": {
        "version": {"const": 2},
        "decoder_route": {"type": "string", "minLength": 1, "maxLength": 512},
        "container": {
          "enum": ["wave", "flac", "ogg", "isobmff", "matroska", "mpeg-audio", "adts", "dsf", "dsdiff"]
        },
        "codec": {
          "enum": [
            "pcm-u8", "pcm-s16le", "pcm-s24le", "pcm-s32le", "pcm-f32le",
            "pcm-f64le", "dsd", "flac", "mp1", "mp2", "mp3", "aac", "alac",
            "vorbis", "opus"
          ]
        },
        "audio_track_index": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "audio_track_id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "source_start_frame": {"type": "integer", "minimum": 0},
        "source_frames": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 1}
          ]
        },
        "sample_rate_hz": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "channels": {"type": "integer", "minimum": 1, "maximum": 1024},
        "channel_roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {"$ref": "#/$defs/channel_role"}
        },
        "declared_layout_provenance": {
          "enum": ["known_speakers", "unknown", "scene_based"]
        },
        "explicit_channel_roles": {"type": "boolean"},
        "declared_channel_layout": {"$ref": "#/$defs/channel_layout"},
        "effective_channel_layout": {"$ref": "#/$defs/channel_layout"},
        "explicit_channel_layout": {"type": "boolean"}
      }
    },
    "range_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "engine_id", "input_descriptor", "timeline_interval_ms"],
      "properties": {
        "kind": {"const": "range"},
        "engine_id": {"enum": ["forge-fast-bs1770-r4", "forge-reference-bs1770-r1"]},
        "input_descriptor": {"$ref": "#/$defs/input_descriptor"},
        "timeline_interval_ms": {
          "oneOf": [
            {"type": "null"},
            {"type": "number", "exclusiveMinimum": 0}
          ]
        }
      }
    },
    "output_domain_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "engine_id", "input_descriptor", "output_sample_rate_hz", "resample_quality"
      ],
      "properties": {
        "kind": {"const": "output_domain"},
        "engine_id": {"const": "forge-fast-bs1770-r4"},
        "input_descriptor": {"$ref": "#/$defs/input_descriptor"},
        "output_sample_rate_hz": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 1, "maximum": 4294967295}
          ]
        },
        "resample_quality": {"enum": ["fast", "balanced", "best"]}
      }
    },
    "timeline_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_seconds", "end_seconds", "momentary_lufs", "short_term_lufs",
        "sample_peak_dbfs", "true_peak_dbtp"
      ],
      "properties": {
        "start_seconds": {"type": "number", "minimum": 0},
        "end_seconds": {"type": "number", "minimum": 0},
        "momentary_lufs": {"$ref": "#/$defs/optional_db_value"},
        "short_term_lufs": {"$ref": "#/$defs/optional_db_value"},
        "sample_peak_dbfs": {"$ref": "#/$defs/db_value"},
        "true_peak_dbtp": {"$ref": "#/$defs/db_value"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_rate_hz", "channels", "channel_roles", "frames", "pcm_kind",
        "integrated_lufs", "max_momentary_lufs", "max_short_term_lufs",
        "loudness_range_lu", "rms_dbfs", "sample_peak_linear", "true_peak_linear",
        "gating_block_mean_squares", "timeline"
      ],
      "properties": {
        "sample_rate_hz": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "channels": {"type": "integer", "minimum": 1, "maximum": 1024},
        "channel_roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {"$ref": "#/$defs/channel_role"}
        },
        "frames": {"type": "integer", "minimum": 0},
        "pcm_kind": {"enum": ["u8", "s16", "s24", "s32", "f32", "f64"]},
        "integrated_lufs": {"$ref": "#/$defs/db_value"},
        "max_momentary_lufs": {"$ref": "#/$defs/db_value"},
        "max_short_term_lufs": {"$ref": "#/$defs/db_value"},
        "loudness_range_lu": {"type": "number", "minimum": 0},
        "rms_dbfs": {"$ref": "#/$defs/db_value"},
        "sample_peak_linear": {"type": "number", "minimum": 0},
        "true_peak_linear": {"type": "number", "minimum": 0},
        "gating_block_mean_squares": {
          "type": "array",
          "maxItems": 1000000,
          "items": {"type": "number", "minimum": 0}
        },
        "timeline": {
          "type": "array",
          "maxItems": 1000000,
          "items": {"$ref": "#/$defs/timeline_point"}
        }
      }
    }
  }
}
