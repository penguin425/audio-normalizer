{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguin425.github.io/audio-normalizer/schema/ac4-adapter-report-v1",
  "title": "Forge AC-4 adapter report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocol_version", "validator", "input_path", "input_bytes", "input_sha256", "adapter_path", "adapter_sha256", "decoder", "ac4_part1_standard", "ac4_part2_standard", "timeout_seconds", "max_decoded_samples_per_presentation", "dialnorm_tolerance_lu", "max_true_peak_dbtp", "presentation_count", "passed", "presentations"],
  "properties": {
    "schema": {"const": "https://penguin425.github.io/audio-normalizer/schema/ac4-adapter-report-v1"},
    "protocol_version": {"const": 1},
    "validator": {"const": "forge-ac4-reference-adapter-1"},
    "input_path": {"type": "string", "minLength": 1},
    "input_bytes": {"type": "integer", "minimum": 0},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter_path": {"type": "string", "minLength": 1},
    "adapter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decoder": {"$ref": "#/$defs/decoder"},
    "ac4_part1_standard": {"const": "ETSI TS 103 190-1 V1.4.1 (2025-07)"},
    "ac4_part2_standard": {"const": "ETSI TS 103 190-2 V1.3.1 (2025-07)"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "max_decoded_samples_per_presentation": {"type": "integer", "minimum": 1, "maximum": 200000000},
    "dialnorm_tolerance_lu": {"type": "number", "minimum": 0, "maximum": 10},
    "max_true_peak_dbtp": {"type": ["number", "null"], "minimum": -100, "maximum": 0},
    "presentation_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "passed": {"type": "boolean"},
    "presentations": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/result"}}
  },
  "$defs": {
    "decoder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "loudness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dialnorm_bits", "dialnorm_lkfs", "dialnorm_source", "downmix_correction_db", "alternative_presentation_correction_db", "realtime_correction_db"],
      "properties": {
        "dialnorm_bits": {"type": "integer", "minimum": 0, "maximum": 127},
        "dialnorm_lkfs": {"type": "number", "minimum": -31.75, "maximum": 0},
        "dialnorm_source": {"enum": ["presentation-substream", "associated-basic-metadata", "main-or-dialogue-substream"]},
        "downmix_correction_db": {"type": ["number", "null"], "minimum": -64, "maximum": 64},
        "alternative_presentation_correction_db": {"type": ["number", "null"], "minimum": -64, "maximum": 64},
        "realtime_correction_db": {"type": ["number", "null"], "minimum": -64, "maximum": 64}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "presentation_version", "output_layout", "language", "accessibility", "loudness_metadata", "rendered_sha256", "rendered_bytes", "sample_rate_hz", "channels", "duration_seconds", "measured_integrated_lufs", "measured_true_peak_dbtp", "dialnorm_drift_lu", "dialnorm_passed", "true_peak_passed", "passed", "checks"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
        "presentation_version": {"type": "integer", "minimum": 0, "maximum": 1},
        "output_layout": {"type": "string", "minLength": 1, "maxLength": 64},
        "language": {"type": ["string", "null"]},
        "accessibility": {"type": ["string", "null"]},
        "loudness_metadata": {"$ref": "#/$defs/loudness"},
        "rendered_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rendered_bytes": {"type": "integer", "minimum": 1},
        "sample_rate_hz": {"type": "integer", "minimum": 1},
        "channels": {"type": "integer", "minimum": 1},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "measured_integrated_lufs": {"type": "number"},
        "measured_true_peak_dbtp": {"type": "number"},
        "dialnorm_drift_lu": {"type": "number"},
        "dialnorm_passed": {"type": "boolean"},
        "true_peak_passed": {"type": ["boolean", "null"]},
        "passed": {"type": "boolean"},
        "checks": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/check"}}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "standard", "measured", "maximum", "unit", "passed"],
      "properties": {
        "rule_id": {"enum": ["FORGE-AC4-DIALNORM-MATCH", "FORGE-AC4-TRUE-PEAK"]},
        "standard": {"type": "string", "minLength": 1},
        "measured": {"type": "number"},
        "maximum": {"type": "number"},
        "unit": {"enum": ["LU", "dBTP"]},
        "passed": {"type": "boolean"}
      }
    }
  }
}
