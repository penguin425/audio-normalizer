{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguin425.github.io/audio-normalizer/schema/analysis-cache-v2",
  "title": "Forge content-addressed analysis cache entry v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generator",
    "measurement_standard",
    "algorithm_revision",
    "created_unix_seconds",
    "input_sha256",
    "request_sha256",
    "request",
    "result_sha256",
    "result"
  ],
  "properties": {
    "schema": {
      "const": "https://penguin425.github.io/audio-normalizer/schema/analysis-cache-v2"
    },
    "generator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "measurement_standard": {
      "const": "ITU-R BS.1770-5 / EBU R 128"
    },
    "algorithm_revision": {
      "const": "forge-bs1770-5-r3"
    },
    "created_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "request": {
      "oneOf": [
        {
          "$ref": "#/$defs/range_request"
        },
        {
          "$ref": "#/$defs/output_domain_request"
        }
      ]
    },
    "result_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "result": {
      "$ref": "#/$defs/result"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "db_value": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "const": "-inf"
        }
      ]
    },
    "optional_db_value": {
      "oneOf": [
        {
          "$ref": "#/$defs/db_value"
        },
        {
          "type": "null"
        }
      ]
    },
    "channel_role": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role"
          ],
          "properties": {
            "role": {
              "enum": [
                "main",
                "surround",
                "dual_mono",
                "lfe"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "azimuth_degrees",
            "elevation_degrees"
          ],
          "properties": {
            "role": {
              "const": "positioned"
            },
            "azimuth_degrees": {
              "type": "integer",
              "minimum": -32768,
              "maximum": 32767
            },
            "elevation_degrees": {
              "type": "integer",
              "minimum": -32768,
              "maximum": 32767
            }
          }
        }
      ]
    },
    "optional_channel_roles": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/channel_role"
          }
        }
      ]
    },
    "range_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "channel_roles",
        "start_seconds",
        "duration_seconds",
        "timeline_interval_ms"
      ],
      "properties": {
        "kind": {
          "const": "range"
        },
        "channel_roles": {
          "$ref": "#/$defs/optional_channel_roles"
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "duration_seconds": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "timeline_interval_ms": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        }
      }
    },
    "output_domain_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "channel_roles",
        "output_sample_rate_hz",
        "resample_quality"
      ],
      "properties": {
        "kind": {
          "const": "output_domain"
        },
        "channel_roles": {
          "$ref": "#/$defs/optional_channel_roles"
        },
        "output_sample_rate_hz": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          ]
        },
        "resample_quality": {
          "enum": [
            "fast",
            "balanced",
            "best"
          ]
        }
      }
    },
    "timeline_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_seconds",
        "end_seconds",
        "momentary_lufs",
        "short_term_lufs",
        "sample_peak_dbfs",
        "true_peak_dbtp"
      ],
      "properties": {
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "minimum": 0
        },
        "momentary_lufs": {
          "$ref": "#/$defs/optional_db_value"
        },
        "short_term_lufs": {
          "$ref": "#/$defs/optional_db_value"
        },
        "sample_peak_dbfs": {
          "$ref": "#/$defs/db_value"
        },
        "true_peak_dbtp": {
          "$ref": "#/$defs/db_value"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_rate_hz",
        "channels",
        "channel_roles",
        "frames",
        "pcm_kind",
        "integrated_lufs",
        "max_momentary_lufs",
        "max_short_term_lufs",
        "loudness_range_lu",
        "rms_dbfs",
        "sample_peak_linear",
        "true_peak_linear",
        "gating_block_mean_squares",
        "timeline"
      ],
      "properties": {
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "channel_roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/channel_role"
          }
        },
        "frames": {
          "type": "integer",
          "minimum": 0
        },
        "pcm_kind": {
          "enum": [
            "u8",
            "s16",
            "s24",
            "s32",
            "f32",
            "f64"
          ]
        },
        "integrated_lufs": {
          "$ref": "#/$defs/db_value"
        },
        "max_momentary_lufs": {
          "$ref": "#/$defs/db_value"
        },
        "max_short_term_lufs": {
          "$ref": "#/$defs/db_value"
        },
        "loudness_range_lu": {
          "type": "number",
          "minimum": 0
        },
        "rms_dbfs": {
          "$ref": "#/$defs/db_value"
        },
        "sample_peak_linear": {
          "type": "number",
          "minimum": 0
        },
        "true_peak_linear": {
          "type": "number",
          "minimum": 0
        },
        "gating_block_mean_squares": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "timeline": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "$ref": "#/$defs/timeline_point"
          }
        }
      }
    }
  }
}
