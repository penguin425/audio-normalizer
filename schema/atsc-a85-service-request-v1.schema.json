{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguin425.github.io/audio-normalizer/schema/atsc-a85-service-request-v1",
  "title": "Forge ATSC A/85:2026 streaming-service QC request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "service_id", "assets"],
  "properties": {
    "schema": { "const": "https://penguin425.github.io/audio-normalizer/schema/atsc-a85-service-request-v1" },
    "service_id": { "$ref": "#/$defs/id" },
    "target_lkfs": { "type": "number", "minimum": -100, "maximum": 0, "default": -24 },
    "target_authority": {
      "enum": ["recommended_range", "prior_arrangement"],
      "default": "recommended_range"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_seconds", "duration_seconds"],
      "properties": {
        "start_seconds": { "type": "number", "minimum": 0 },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "programme_kind", "delivery_codec", "declaration_source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "programme_kind": { "enum": ["long_form", "short_form"] },
        "delivery_codec": {
          "enum": ["ac3", "ac4", "dts-uhd", "e-ac3", "mpeg-h", "xhe-aac", "aac", "mpeg-layer2", "mp3"]
        },
        "declaration_source": { "type": "string", "minLength": 1, "maxLength": 512 },
        "declared_loudness_lkfs": { "type": "number", "minimum": -100, "maximum": 0 },
        "dialogue_free": { "type": "boolean", "default": false },
        "dialogue_ranges": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/range" },
          "default": []
        },
        "accompanies": { "$ref": "#/$defs/id" },
        "inserted": { "type": "boolean", "default": false },
        "channel_layout": { "enum": ["mono", "stereo", "5.1", "6.1", "7.1", "5.1.4", "7.1.4"] }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "delivery_codec": { "enum": ["ac3", "ac4", "dts-uhd", "e-ac3", "mpeg-h", "xhe-aac"] }
            },
            "required": ["delivery_codec"]
          },
          "then": { "required": ["declared_loudness_lkfs"] },
          "else": { "not": { "required": ["declared_loudness_lkfs"] } }
        },
        {
          "if": {
            "properties": { "programme_kind": { "const": "short_form" } },
            "required": ["programme_kind"]
          },
          "then": {
            "required": ["accompanies"],
            "properties": {
              "dialogue_free": { "const": false },
              "dialogue_ranges": { "maxItems": 0 }
            }
          },
          "else": {
            "not": { "required": ["accompanies"] }
          }
        },
        {
          "if": {
            "properties": {
              "programme_kind": { "const": "long_form" },
              "dialogue_free": { "const": false }
            },
            "required": ["programme_kind"]
          },
          "then": {
            "required": ["dialogue_ranges"],
            "properties": { "dialogue_ranges": { "minItems": 1 } }
          }
        },
        {
          "if": {
            "properties": { "dialogue_free": { "const": true } },
            "required": ["dialogue_free"]
          },
          "then": {
            "properties": { "dialogue_ranges": { "maxItems": 0 } }
          }
        },
        {
          "if": {
            "properties": { "inserted": { "const": true } },
            "required": ["inserted"]
          },
          "then": {
            "properties": { "programme_kind": { "const": "short_form" } }
          }
        }
      ]
    }
  }
}
