{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://penguin425.github.io/audio-normalizer/schema/batch-progress-v2",
  "title": "Forge batch progress event v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generator",
    "sequence",
    "event",
    "job_id",
    "generation",
    "phase",
    "completed",
    "total"
  ],
  "properties": {
    "schema": {
      "const": "https://penguin425.github.io/audio-normalizer/schema/batch-progress-v2"
    },
    "generator": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^forge-normalizer/[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sequence": {"type": "integer", "minimum": 0},
    "event": {
      "enum": [
        "job_started",
        "asset_started",
        "asset_completed",
        "asset_skipped",
        "asset_failed",
        "job_completed",
        "job_failed"
      ]
    },
    "job_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generation": {"type": "integer", "minimum": 0},
    "phase": {"enum": ["rendering", "committed", "failed"]},
    "completed": {"type": "integer", "minimum": 0, "maximum": 100000},
    "total": {"type": "integer", "minimum": 1, "maximum": 100000},
    "index": {"type": "integer", "minimum": 0, "maximum": 99999},
    "input": {"type": "string", "minLength": 1, "maxLength": 4096},
    "output": {"type": "string", "minLength": 1, "maxLength": 4096},
    "error": {"type": "string", "minLength": 1, "maxLength": 16384}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "enum": [
              "asset_started",
              "asset_completed",
              "asset_skipped",
              "asset_failed"
            ]
          }
        }
      },
      "then": {"required": ["index", "input", "output"]},
      "else": {
        "not": {"anyOf": [
          {"required": ["index"]},
          {"required": ["input"]},
          {"required": ["output"]}
        ]}
      }
    },
    {
      "if": {
        "properties": {
          "event": {"enum": ["asset_failed", "job_failed"]}
        }
      },
      "then": {"required": ["error"]},
      "else": {"not": {"required": ["error"]}}
    },
    {
      "if": {
        "properties": {
          "event": {"enum": ["job_started", "asset_started"]}
        }
      },
      "then": {"properties": {"phase": {"const": "rendering"}}}
    },
    {
      "if": {
        "properties": {
          "event": {"enum": ["asset_completed", "asset_skipped", "job_completed"]}
        }
      },
      "then": {"properties": {"phase": {"const": "committed"}}}
    },
    {
      "if": {
        "properties": {
          "event": {"enum": ["asset_failed", "job_failed"]}
        }
      },
      "then": {"properties": {"phase": {"const": "failed"}}}
    }
  ]
}
